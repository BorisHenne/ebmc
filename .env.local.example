# =============================================================================
# EBMC GROUP - Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env.local et remplir les valeurs
# NE JAMAIS commiter .env.local dans Git !

# -----------------------------------------------------------------------------
# Base de données (Prisma)
# -----------------------------------------------------------------------------
# Local (développement) - SQLite
DATABASE_URL="file:./dev.db"

# Production - MySQL Infomaniak
# DATABASE_URL="mysql://username:password@hostname:3306/database_name?sslaccept=strict"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# URL de base de l'application
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://ebmcgroup.eu"

# Secret pour chiffrer les sessions (générer avec: openssl rand -base64 32)
NEXTAUTH_SECRET=""

# -----------------------------------------------------------------------------
# OAuth Provider: Google
# -----------------------------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# OAuth Provider: Apple
# -----------------------------------------------------------------------------
# Console: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""

# -----------------------------------------------------------------------------
# OAuth Provider: Microsoft (Azure AD)
# -----------------------------------------------------------------------------
# Console: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# -----------------------------------------------------------------------------
# OAuth Provider: Boondmanager (Custom)
# -----------------------------------------------------------------------------
# Documentation: https://doc.boondmanager.com/
BOOND_CLIENT_ID=""
BOOND_CLIENT_SECRET=""
BOOND_API_URL="https://[instance].boondmanager.com/api"
BOOND_INSTANCE="[instance]"

# Authentification API Boond (Basic Auth pour certaines routes)
BOOND_API_USER=""
BOOND_API_TOKEN=""

# -----------------------------------------------------------------------------
# Email SMTP (Infomaniak)
# -----------------------------------------------------------------------------
SMTP_HOST="mail.infomaniak.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="EBMC GROUP <contact@ebmcgroup.eu>"

# Email de réception du formulaire de contact
CONTACT_EMAIL="contact@ebmcgroup.eu"

# -----------------------------------------------------------------------------
# Make.com (Webhook orchestration)
# -----------------------------------------------------------------------------
MAKE_WEBHOOK_CONTACT=""
MAKE_WEBHOOK_CANDIDATE=""
MAKE_API_KEY=""

# -----------------------------------------------------------------------------
# Infomaniak Deployment
# -----------------------------------------------------------------------------
INFOMANIAK_SSH_HOST=""
INFOMANIAK_SSH_USER=""
INFOMANIAK_SSH_KEY=""
INFOMANIAK_DEPLOY_PATH="/home/clients/[id]/web/ebmcgroup.eu"

# -----------------------------------------------------------------------------
# Analytics & Monitoring (optionnel)
# -----------------------------------------------------------------------------
# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Sentry (error tracking)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# -----------------------------------------------------------------------------
# Public Variables (exposées au client)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EBMC GROUP"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# Google Maps (pour la page contact)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# reCAPTCHA v3 (protection formulaires)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
