# =============================================================================
# EBMC GROUP - Docker Environment Variables
# =============================================================================
# Copier ce fichier en .env et modifier les valeurs
# cp .env.docker.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Configuration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ebmc-group
NODE_ENV=production

# Ports exposés (adaptés pour UGreen DXP4800 Plus)
APP_PORT=3080
MYSQL_PORT=3307
ADMINER_PORT=8180

# -----------------------------------------------------------------------------
# MySQL Database
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=ebmc_root_2024_CHANGE_ME
MYSQL_DATABASE=ebmc_group
MYSQL_USER=ebmc_user
MYSQL_PASSWORD=ebmc_password_2024_CHANGE_ME

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# URL accessible depuis l'extérieur (IP NAS ou domaine)
NEXT_PUBLIC_APP_URL=http://192.168.1.29:3080
NEXTAUTH_URL=http://192.168.1.29:3080

# Si vous utilisez un domaine local (modifier /etc/hosts ou DNS local)
# NEXT_PUBLIC_APP_URL=http://ebmc.local:3080
# NEXTAUTH_URL=http://ebmc.local:3080

# -----------------------------------------------------------------------------
# NextAuth Secret
# -----------------------------------------------------------------------------
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# -----------------------------------------------------------------------------
# OAuth Providers (optionnel pour le dev local)
# -----------------------------------------------------------------------------
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Microsoft Azure AD
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# -----------------------------------------------------------------------------
# Boondmanager API
# -----------------------------------------------------------------------------
BOOND_CLIENT_ID=
BOOND_CLIENT_SECRET=
BOOND_INSTANCE=ebmc-group
BOOND_API_USER=
BOOND_API_TOKEN=

# -----------------------------------------------------------------------------
# SMTP Email (Infomaniak ou autre)
# -----------------------------------------------------------------------------
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contact@ebmcgroup.eu

# -----------------------------------------------------------------------------
# Make.com Webhooks
# -----------------------------------------------------------------------------
MAKE_WEBHOOK_CONTACT=
MAKE_WEBHOOK_CANDIDATE=

# -----------------------------------------------------------------------------
# Traefik Reverse Proxy (optionnel - pour HTTPS)
# -----------------------------------------------------------------------------
# Domaine pour accès externe
DOMAIN=ebmc.local

# Email pour Let's Encrypt
ACME_EMAIL=admin@ebmcgroup.eu

# Auth pour dashboard Traefik (générer avec: htpasswd -nb admin password)
TRAEFIK_AUTH=admin:$$apr1$$xyz$$hash

# -----------------------------------------------------------------------------
# reCAPTCHA (optionnel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
