// =============================================================================
// EBMC GROUP - Schéma Prisma
// =============================================================================
// Base de données pour l'authentification et la gestion des utilisateurs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL pour production NAS / Infomaniak
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// NextAuth.js Models
// -----------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// User Model (Extended)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(VIEWER)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  // Relations
  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // Boond Integration
  boondResourceId String? @unique @map("boond_resource_id")

  @@map("users")
}

// -----------------------------------------------------------------------------
// Allowed Users (Whitelist)
// -----------------------------------------------------------------------------
// Seuls les emails dans cette table peuvent accéder au back-office

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(VIEWER)
  addedBy   String?  @map("added_by")
  addedAt   DateTime @default(now()) @map("added_at")
  note      String?

  @@map("allowed_users")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN  // Accès total
  ADMIN        // Gestion contenus + utilisateurs limités
  EDITOR       // Modification contenus
  VIEWER       // Lecture seule
}

// -----------------------------------------------------------------------------
// Contact Form Submissions
// -----------------------------------------------------------------------------

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  subject     String
  message     String   @db.Text
  locale      String   @default("fr")
  source      String?  // Page d'origine
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  boondContactId String? @map("boond_contact_id")
  status      ContactStatus @default(NEW)

  @@map("contact_submissions")
}

enum ContactStatus {
  NEW
  PROCESSING
  SENT_TO_BOOND
  REPLIED
  ARCHIVED
}

// -----------------------------------------------------------------------------
// Audit Log
// -----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relation
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Settings (Key-Value Store)
// -----------------------------------------------------------------------------

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}
