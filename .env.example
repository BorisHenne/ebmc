# =============================================================================
# EBMC GROUP - Environment Variables
# =============================================================================

# PostgreSQL Database
POSTGRES_DB=ebmc
POSTGRES_USER=ebmc
POSTGRES_PASSWORD=your_secure_password_here

# Application
APP_PORT=3080
DATABASE_URL=postgresql://ebmc:your_secure_password_here@db:5432/ebmc?schema=public
NODE_ENV=production

# Authentication (important: change in production!)
JWT_SECRET=ebmc-jwt-secret-change-in-production
